# Variáveis lidas por src/config/index.js
PORT=3000
# ':memory:' perde os dados a cada restart; use um arquivo (ex.: ./lms.db) para persistir.
DB_PATH=:memory:
# Token exigido no header X-Admin-Token das rotas administrativas.
# Vazio = rotas /api/admin/* e DELETE /api/users/:id bloqueadas.
ADMIN_TOKEN=
LOG_LEVEL=info
