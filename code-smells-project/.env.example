# Chave usada para assinar tokens de login. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio
# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600
# Modo debug do Flask (nunca habilite em produção)
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Exibido no /health
APP_ENV=development
